# Script: DefragVolumeSys 
# Defrag System Volume

Title('Defrag System Volume')
Description("Defrag System Volume using Complex structure") 

SetVariable(VolumeLabel,		"!VolumeSys!")
SetVariable(VolumeLabelSelect,	'!include "..\VolumeType\VolumeTypeSys.MyDc"!')

SetVariable(VolumeDescription,	"System")
!include "..\Display\DisplaySetVolume.MyDc"!

!include "..\Settings\SettingsRunVolume.MyDc"!

SetVariable(MftZone,			 "Regular")

!include "..\Settings\SettingsYours\SettingsYoursSys.MyDc"!

!include "..\Defrag\DefragAnyComplexVolume.MyD"!

Writelogfile("Defrag System Volume.TaylorDoLog",	'!StatisticsWindowText!')
